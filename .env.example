# Copy to .env (gitignored) or export in your shell / GitHub Actions secret.
# ODDS_API_KEY_NEW is preferred when set (use this to replace an exhausted key).
# Use the Odds dashboard API Key (32-char hex), not the account UUID.
ODDS_API_KEY=
# ODDS_API_KEY_NEW=
# THE_ODDS_API_KEY=
# Optional credit savers (defaults shown):
# ODDS_CACHE_TTL_MIN=45
# ODDS_CACHE_DIR=.cache/odds
